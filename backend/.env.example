# Backend runtime configuration for Ember.
# Copy to .env and fill in your values:
#   cp backend/.env.example backend/.env
# Never commit the real .env file.

# --- Google Cloud ---
# The Project ID of your GCP project (looks like "ember-123456" or similar,
# NOT the project number). Find it in the top dropdown of the Cloud console.
GOOGLE_CLOUD_PROJECT=

# Region where your Vertex AI models respond (Gemini).
GOOGLE_CLOUD_REGION=us-central1

# Only needed if you use a service-account JSON key instead of "gcloud auth
# application-default login". Leave empty when using ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Models ---
# Gemini (deep emotional coaching) — via Vertex AI (regional endpoint).
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemma (privacy layer: PII anonymization + safety + mood) — Vertex global
# endpoint (MaaS models are only served there). Requires ADC credentials.
GEMMA_MODEL=gemma-4-26b-a4b-it-maas

# --- Firestore (optional; falls back to in-memory when unavailable) ---
FIRESTORE_COLLECTION_USERS=users
FIRESTORE_COLLECTION_JOURNAL=journal_entries

# --- API security ---
# Shared secret required in the X-API-Key header (any long random string,
# e.g. `openssl rand -hex 32`). Empty = auth disabled (local dev only).
# IMPORTANT: SET THIS when deploying to Cloud Run — otherwise anyone can
# call your API and use your Gemini quota.
EMBER_API_KEY=

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Server ---
HOST=0.0.0.0
PORT=8080